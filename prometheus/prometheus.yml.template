global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: auth-service
    scheme: __AUTH_SCHEME__
    metrics_path: __AUTH_PATH__
    static_configs:
      - targets:
          - __AUTH_HOST__
        labels:
          service: auth-service

  - job_name: venue-service
    scheme: __VENUE_SCHEME__
    metrics_path: __VENUE_PATH__
    static_configs:
      - targets:
          - __VENUE_HOST__
        labels:
          service: venue-service

  - job_name: notification-service
    scheme: __NOTIFICATION_SCHEME__
    metrics_path: __NOTIFICATION_PATH__
    static_configs:
      - targets:
          - __NOTIFICATION_HOST__
        labels:
          service: notification-service

  - job_name: report-service
    scheme: __REPORT_SCHEME__
    metrics_path: __REPORT_PATH__
    static_configs:
      - targets:
          - __REPORT_HOST__
        labels:
          service: report-service

  - job_name: storage-service
    scheme: __STORAGE_SCHEME__
    metrics_path: __STORAGE_PATH__
    static_configs:
      - targets:
          - __STORAGE_HOST__
        labels:
          service: storage-service

  - job_name: workflow-service
    scheme: __WORKFLOW_SCHEME__
    metrics_path: __WORKFLOW_PATH__
    static_configs:
      - targets:
          - __WORKFLOW_HOST__
        labels:
          service: workflow-service